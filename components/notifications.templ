package components

templ NotificationsPage(items []NotificationItem, unread int64) {
	@Base("Notifications", true, unread) {
		<h1 class="text-2xl font-bold">Notifications</h1>
		if len(items) == 0 {
			<div role="alert" class="alert mt-4">
				<span class="text-sm">No notifications.</span>
			</div>
		} else {
			<ul class="mt-4 space-y-2">
				for _, n := range items {
					<li class={ "card card-border p-3 text-sm", templ.KV("bg-base-100", n.IsRead == 0), templ.KV("bg-base-200 opacity-75", n.IsRead != 0) }>
						{ n.Body }
					</li>
				}
			</ul>
			<form method="POST" action="/notifications/read" class="mt-4">
				<button type="submit" class="btn btn-outline btn-sm">Mark all read</button>
			</form>
		}
	}
}

templ NotificationsBellFragment(count int64) {
	@NotificationBell(count)
}
