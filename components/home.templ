package components

templ HomePage(isAuthed bool, unread int64, username, displayName string) {
	@Base("memri — Home", isAuthed, unread) {
		if isAuthed {
			<div class="hero">
				<div class="hero-content text-center">
					<div>
						<h1 class="text-2xl font-bold">Hello, { displayName } ({ username })</h1>
						<p class="mt-2 text-base-content/80">Welcome back to memri.</p>
					</div>
				</div>
			</div>
			@DeckSearch()
		} else {
			<div class="hero">
				<div class="hero-content text-center">
					<div class="max-w-2xl">
						<h1 class="text-4xl font-bold tracking-tight">Welcome to memri</h1>
						<p class="mt-4 text-base-content/80">Server-rendered Go + Templ + htmx. No SPA, no JWT, no email.</p>
						<div class="mt-8 flex justify-center gap-4">
							<div class="aura">
								<a href="/register" class="btn">Get started</a>
							</div>
							<div class="aura">
								<a href="/login" class="btn">Login</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	}
}

templ GreetingFragment(name string) {
	<div role="alert" class="alert alert-info">
		<span>Hello, { name }! Rendered at server — time is server time.</span>
	</div>
}
